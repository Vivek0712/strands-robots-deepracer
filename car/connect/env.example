# Copy to ~/.config/deepracer/env (outside the repo). Never commit the real file.
DEEPRACER_HOST=auto                 # auto = find the car on this network (docs/dev/networking.md); or an IP
DEEPRACER_MAC=02:00:00:ab:cd:ef     # the car's Wi-Fi MAC (ip link on the car, or the router's client list); never changes
DEEPRACER_MDNS=amss-abcd.local      # the car's hostname + .local (hostname on the car); works when the network passes mDNS
DEEPRACER_SSH_USER=deepracer        # community 24.04 image default
DEEPRACER_SSH_PASSWORD=deepracer    # image default; only used once, to install the SSH key
DEEPRACER_CONSOLE_PASSWORD=         # sticker password for https://<host> (the web console)
DEEPRACER_SSH_KEY=~/.ssh/id_ed25519_deepracer
